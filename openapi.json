              }
            ],
            "title": "Perspective"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          },
          "chunk_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Ids",
            "description": "Array of chunk IDs linking this node to multiple source sections"
          },
          "properties": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Properties"
          },
          "embedding": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding",
            "description": "Embedding vector for the node, if applicable"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CustomNodeData",
        "example": {
          "chunk_ids": [
            "book_27_chapter_1",
            "book_27_chapter_5"
          ],
          "embedding": [
            0.1,
            0.2,
            0.3
          ],
          "name": "Quantum Computing",
          "properties": {
            "discipline": "Computer Science",
            "bloom_level": "Understand",
            "confidence": "0.9"
          },
          "type": "Concept"
        }
      },
      "CustomRelationshipData": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "relation_type": {
            "type": "string",
            "title": "Relation Type"
          },
          "data": {
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "source",
          "target",
          "relation_type"
        ],
        "title": "CustomRelationshipData"
      },
      "GraphUIDataResponse": {
        "properties": {
          "topics": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Topics"
          },
          "insights": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Insights"
          },
          "sources": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Sources"
          },
          "nodes": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Nodes"
          },
          "relationships": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Relationships"
          }
        },
        "type": "object",
        "required": [
          "topics",
          "insights",
          "sources",
          "nodes",
          "relationships"
        ],
        "title": "GraphUIDataResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RAGQuery": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          }
        },
        "type": "object",
        "required": [
