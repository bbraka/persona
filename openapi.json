            "title": "Nodes"
          },
          "relationships": {
            "items": {
              "$ref": "#/components/schemas/CustomRelationshipData"
            },
            "type": "array",
            "title": "Relationships"
          }
        },
        "type": "object",
        "required": [
          "nodes",
          "relationships"
        ],
        "title": "CustomGraphUpdate",
        "example": {
          "nodes": [
            {
              "name": "Favorite Movie",
              "perspective": "user preference",
              "properties": {
                "genre": "Sci-Fi",
                "rating": "9/10"
              }
            }
          ],
          "relationships": [
            {
              "data": {
                "confidence": 0.9
              },
              "relation_type": "IS",
              "source": "Favorite Movie",
              "target": "Interstellar"
            }
          ]
        }
      },
      "CustomNodeData": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "perspective": {
            "anyOf": [
              {
                "type": "string"
              },
              {
