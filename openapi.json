    "/api/v1/users/{user_id}/graph-ui-data": {
      "get": {
        "summary": "Get Graph Ui Data",
        "description": "Retrieve comprehensive graph data for UI visualization with optional filtering.\n\nQuery Parameters:\n- search: Search term to filter nodes by name or properties (case-insensitive)\n- topics: Comma-separated list of topics/disciplines to filter by (e.g., \"Music,Art,Technology\")\n- min_confidence: Minimum confidence score for insights (default: 0.7)\n- sources: Comma-separated list of sources/perspectives to filter by\n\nReturns:\n- topics: Aggregated by discipline with entity counts, relationship counts, and Bloom level distribution\n- insights: High-confidence nodes (confidence >= min_confidence, default 0.7)\n- sources: Aggregated by perspective or type\n- nodes: Filtered graph nodes with properties (including chunk_ids array if present, excluding embeddings)\n- relationships: Graph relationships connecting filtered nodes",
        "operationId": "get_graph_ui_data_api_v1_users__user_id__graph_ui_data_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The unique identifier for the user",
              "title": "User Id"
            },
            "description": "The unique identifier for the user"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search term to filter nodes by name or properties",
              "title": "Search"
            },
            "description": "Search term to filter nodes by name or properties"
          },
          {
            "name": "topics",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated list of topics/disciplines to filter by",
              "title": "Topics"
            },
            "description": "Comma-separated list of topics/disciplines to filter by"
          },
          {
            "name": "min_confidence",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1.0,
                  "minimum": 0.0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum confidence score for insights (0.0-1.0)",
              "title": "Min Confidence"
            },
            "description": "Minimum confidence score for insights (0.0-1.0)"
          },
          {
            "name": "sources",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated list of sources/perspectives to filter by",
              "title": "Sources"
            },
            "description": "Comma-separated list of sources/perspectives to filter by"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphUIDataResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
